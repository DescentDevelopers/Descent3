 				stdi(BIT, ABIT) \
 				sreg ## ABIT(1, lreg ## ABIT(1) - 1); \
+				REP_STEP(1) \
+				REP_YIELD() \
 			} \
 			break; \
 		} \
@@ -2680,6 +2693,8 @@ static bool call_isr(CPUI386 *cpu, int no, bool pusherr, int ext);
 		sreg ## ABIT(7, lreg ## ABIT(7) + count * dir); \
 		sreg ## ABIT(1, cx - count); \
 		cx = lreg ## ABIT(1); \
+		REP_STEP(count) \
+		REP_YIELD() \
 	}
 
